# Analyzer-only secrets/settings. Keep this file as a template; never commit real keys.
INTERNAL_TOKEN=replace-with-random-internal-token

# Local OCR fallback
OCR_LANG=ara+eng
OCR_ROTATED_DIMENSIONS=1

# Optional higher-quality cloud OCR. Leave CLOUD_OCR_PROVIDER empty to use Tesseract only.
CLOUD_OCR_PROVIDER=google-vision
GOOGLE_VISION_API_KEY=
CLOUD_OCR_TIMEOUT_SECONDS=35

# Optional semantic providers for ambiguous H Engineer language.
# Example value is intentionally empty. Keys referenced by key_env must exist only in server environment.
H_ENGINEER_PROVIDERS_JSON=[]


# Optional architectural symbol detector. Runs only server-side.
# POST receives image/png bytes and returns:
# {"symbols":[{"kind":"sink","bbox":[x1,y1,x2,y2],"confidence":0.92}]}
# Supported kinds: sink, toilet, bathtub, shower, cooktop, stairs.
SYMBOL_DETECTOR_URL=
SYMBOL_DETECTOR_TOKEN=
SYMBOL_MIN_CONFIDENCE=0.78
SYMBOL_DETECTOR_TIMEOUT_SECONDS=45


# Optional in-process ONNX/YOLO detector. Preferred over SYMBOL_DETECTOR_URL when configured.
# The model file is mounted into the Analyzer container; do not commit proprietary weights.
# Classes may be JSON or comma-separated and are normalized through the supported symbol aliases.
SYMBOL_ONNX_MODEL=
SYMBOL_ONNX_CLASSES=["sink","toilet","bathtub","shower","cooktop","stairs"]
SYMBOL_ONNX_INPUT_SIZE=640
SYMBOL_ONNX_NMS_IOU=0.45
