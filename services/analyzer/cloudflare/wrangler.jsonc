{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "manzil-h-analyzer",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "containers": [
    {
      "class_name": "AnalyzerContainer",
      "image": "../Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ANALYZER_CONTAINER",
        "class_name": "AnalyzerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AnalyzerContainer"]
    }
  ]
}
